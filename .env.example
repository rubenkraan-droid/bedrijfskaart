# Kopieer dit bestand naar .env.local en vul de waarden in.
# Supabase-dashboard > Settings > API Keys.

NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co

# Onder "Publishable key". Mag in de browser staan.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Onder "Secret keys". Alleen voor de server: gaat buiten Row Level Security om,
# dus nooit in de browser en nooit in git.
SUPABASE_SECRET_KEY=sb_secret_...
